{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quality-passport-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quality-passport",
      "database_id": "991a9867-4b0b-4115-bba5-92d01759e7ef",
      "migrations_dir": "migrations"
    }
  ],
  // Copy of the questions written in the Sheet ("Questions" tab), served close to each participant.
  // Namespace "quality-passport-api-questions", created by the first deploy (2026-11-02).
  "kv_namespaces": [
    { "binding": "QUESTIONS", "id": "a8382dfb46804db4a5f0d789865af0e7" }
  ],
  // Every minute, new answers are copied to the Google Sheet in one batch, and the questions are read back.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Apps Script web app (apps-script/Code.gs, deployment "Version 6 · séries": actions "batch" and "questions").
    // Empty = no copy to the Sheet (answers stay in D1).
    "SHEET_URL": "https://script.google.com/macros/s/AKfycbytjJmchZZpmR7wE_iJXUINYzG_dsR3tsKjnvziYfOrBaB75NFxTFTpPzgGA8qdh90i9w/exec"
  },
  "observability": { "enabled": true }
}
